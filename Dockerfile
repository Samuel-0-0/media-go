FROM app AS verify
WORKDIR /home/app
COPY --chown=1000:1000 <<'MEDIAGO_RUNTIME_CHECK' /home/app/verify-runtime.py
"""Offline smoke test for the Docker runtime; run as the image's application user."""

import argparse
from contextlib import contextmanager
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request


@contextmanager
def local_source():
    requested = threading.Event()

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            requested.set()
            body = (
                b'<!doctype html><html><body><p>MediaGo fixture</p>'
                b'<script type="application/ld+json">{"@type":"ItemList",'
                b'"itemListElement":[{"item":{"name":"Fixture anime",'
                b'"url":"https://youranimes.tw/animes/5274"}}]}</script></body></html>'
            )
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_):
            pass

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    worker = threading.Thread(target=server.serve_forever, daemon=True)
    worker.start()
    try:
        yield "http://127.0.0.1:" + str(server.server_port), requested
    finally:
        server.shutdown()
        server.server_close()
        worker.join(timeout=5)


def command_version(command, pattern, minimum):
    result = subprocess.run(
        command, capture_output=True, text=True, timeout=30, check=True,
    )
    output = result.stdout + result.stderr
    match = re.search(pattern, output)
    if match is None or int(match.group(1)) < minimum:
        raise AssertionError("Unsupported runtime: " + command[0])
    print(output.splitlines()[0])


def check_dependencies(options):
    if sys.version_info < (3, 10):
        raise AssertionError("Python 3.10 or later is required")
    import requests
    from bs4 import BeautifulSoup
    from Crypto.Cipher import AES
    from Crypto.Util.Padding import pad, unpad
    from lxml import html
    from lxml.cssselect import CSSSelector
    from pyquery import PyQuery

    assert PyQuery("<ul><li>MediaGo fixture</li></ul>")("li").text() == "MediaGo fixture"
    with local_source() as (url, requested), requests.Session() as session:
        session.trust_env = False
        response = session.get(url, timeout=5)
        response.raise_for_status()
        assert requested.is_set()
        assert html.fromstring(response.content).xpath("string(//p)") == "MediaGo fixture"
        assert BeautifulSoup(response.content, "lxml").select_one("p").get_text() == "MediaGo fixture"
        assert len(CSSSelector("p")(html.fromstring(response.content))) == 1
    key, iv, message = b"0123456789abcdef", b"fedcba9876543210", b"MediaGo AES fixture"
    encrypted = AES.new(key, AES.MODE_CBC, iv).encrypt(pad(message, AES.block_size))
    assert unpad(AES.new(key, AES.MODE_CBC, iv).decrypt(encrypted), AES.block_size) == message
    print("Python HTTP, HTML parsing, CSS selection, PyQuery, and Crypto AES dependencies: OK")
    command_version([options.node, "--version"], r"v(\d+)\.", 22)


def read_json(opener, url):
    with opener.open(url, timeout=2) as response:
        assert response.status == 200
        return json.load(response)


def check_application(options):
    if not hasattr(os, "geteuid") or os.geteuid() == 0:
        raise AssertionError("Run the container smoke test as a non-root user")
    with tempfile.TemporaryDirectory(prefix="mediago-runtime-", dir="/data") as directory:
        data = Path(directory)
        with tempfile.TemporaryFile(dir=Path.home()) as home_file:
            home_file.write(b"home is writable")
        with socket.socket() as reservation:
            reservation.bind(("127.0.0.1", 0))
            address = "127.0.0.1:" + str(reservation.getsockname()[1])
        with local_source() as (source, requested):
            # A fresh data directory has no subscriptions, bindings or Bangumi
            # token. Startup must not acquire a Japanese season automatically.
            environ = {key: os.environ[key] for key in (
                "PATH", "HOME", "LANG", "LC_ALL", "TZ", "LD_LIBRARY_PATH",
            ) if key in os.environ}
            environ.update({
                "DATA_DIR": str(data), "DOWNLOAD_DIR": str(data / "downloads"),
                "HTTP_ADDR": address, "SOURCE_BASE_URL": source,
                "KKYS_BASE_URL": source,
            })
            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            with tempfile.TemporaryFile(mode="w+b") as output:
                process = subprocess.Popen(
                    ["/app/docker-entrypoint.sh"], env=environ,
                    stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
                try:
                    deadline = time.monotonic() + 20
                    while True:
                        if process.poll() is not None:
                            raise AssertionError("Application exited before becoming ready")
                        try:
                            assert read_json(opener, "http://" + address + "/healthz")["status"] == "ok"
                            break
                        except (OSError, urllib.error.URLError):
                            if time.monotonic() >= deadline:
                                raise AssertionError("Application readiness timed out") from None
                            time.sleep(0.1)
                    version = read_json(opener, "http://" + address + "/api/version")["version"]
                    assert isinstance(version, str) and version.strip()
                    if options.version:
                        assert version == options.version, (version, options.version)
                    subprocess.run(
                        [sys.executable, "/app/docker-healthcheck.py"],
                        env=environ, timeout=5, check=True,
                    )
                    assert (data / "downloads").is_dir()
                    (data / "write-check").write_text("persistent directory is writable", encoding="utf-8")
                    assert not requested.wait(timeout=3), "Startup automatically fetched a Japanese season"
                    assert read_json(opener, "http://" + address + "/api/sources") == []
                    request = urllib.request.Request(
                        "http://" + address + "/api/seasons/202601", method="POST",
                    )
                    assert len(read_json(opener, request)) == 1, "Manual season fetch failed"
                    assert requested.is_set(), "Manual fetch did not reach the local fixture"
                    assert read_json(opener, "http://" + address + "/api/sources") == ["202601"]
                    process.terminate()
                    assert process.wait(timeout=15) == 0, "Application did not stop cleanly through tini"
                    print("Application " + version + ": health, version, data permissions, manual-only season acquisition and SIGTERM shutdown OK")
                except BaseException:
                    output.seek(0)
                    print(output.read()[-8192:].decode("utf-8", errors="replace"), file=sys.stderr)
                    raise
                finally:
                    if process.poll() is None:
                        os.killpg(process.pid, signal.SIGKILL)
                        process.wait(timeout=5)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dependencies-only", action="store_true", help="check runtimes without starting the container application")
    parser.add_argument("--node", default="node")
    parser.add_argument("--version", help="optional expected application version")
    options = parser.parse_args()
    check_dependencies(options)
    if not options.dependencies_only:
        check_application(options)


if __name__ == "__main__":
    main()
