COPY <<'MEDIAGO_HEALTHCHECK' /app/docker-healthcheck.py
"""Container health probe using the listener selected at application startup.

The entrypoint invokes --snapshot once before starting MediaGo. Ordinary probes
never reread settings.json: saved listener changes only apply after a restart.
"""

import argparse
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request


DEFAULT_STATE = "/tmp/mediago-healthcheck.json"
REQUEST_TIMEOUT = 3
MAX_RESPONSE_BYTES = 4096


class HealthcheckError(Exception):
    """Contains only a fixed diagnostic, never application configuration."""


def health_url(address):
    if not isinstance(address, str) or not address or any(c.isspace() for c in address):
        raise HealthcheckError("Invalid application listen address.")
    if address.startswith("["):
        match = re.fullmatch(r"\[([^\[\]]+)\]:([0-9]+)", address)
        if match is None:
            raise HealthcheckError("Invalid application listen address.")
        host, port_text = match.groups()
        try:
            parsed = ipaddress.IPv6Address(host)
        except ValueError:
            raise HealthcheckError("Invalid application listen address.") from None
        if parsed.scope_id is not None:
            raise HealthcheckError("Scoped IPv6 listen addresses are not supported by the health probe.")
        host = "::1" if parsed.is_unspecified else host
        host = "[" + host + "]"
    else:
        match = re.fullmatch(r"([A-Za-z0-9_.-]*):([0-9]+)", address)
        if match is None:
            raise HealthcheckError("Invalid application listen address.")
        host, port_text = match.groups()
        if host in ("", "0.0.0.0"):
            host = "127.0.0.1"
        elif host.startswith((".", "-")) or host.endswith("-") or ".." in host:
            raise HealthcheckError("Invalid application listen address.")
    if len(port_text) > 5 or not 1 <= int(port_text) <= 65535:
        raise HealthcheckError("Invalid application listen port.")
    return "http://" + host + ":" + str(int(port_text)) + "/healthz"


def startup_address(environ):
    address = environ.get("HTTP_ADDR", "")
    if address:
        return address
    settings_path = Path(environ.get("DATA_DIR") or "/data") / "settings.json"
    try:
        with settings_path.open("rb") as source:
            encoded = source.read((32 << 10) + 1)
    except FileNotFoundError:
        return ":8080"
    except OSError:
        raise HealthcheckError("Cannot read application settings for the health probe.") from None
    try:
        if len(encoded) > 32 << 10:
            raise ValueError()
        settings = json.loads(encoded)
        if not isinstance(settings, dict) or settings.get("schema_version") != 1:
            raise ValueError()
        values = settings.get("values")
        if not isinstance(values, dict):
            raise ValueError()
        address = values.get("HTTP_ADDR", ":8080")
        if not isinstance(address, str):
            raise ValueError()
    except (ValueError, UnicodeError, RecursionError):
        raise HealthcheckError("Invalid application settings for the health probe.") from None
    return address


def save_snapshot(state_path, environ):
    url = health_url(startup_address(environ))
    path = Path(state_path)
    temporary = None
    try:
        descriptor, temporary = tempfile.mkstemp(prefix=".mediago-health-", dir=path.parent)
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            os.chmod(temporary, 0o600)
            json.dump({"schema_version": 1, "url": url}, output)
            output.write("\n")
        os.replace(temporary, path)
        temporary = None
    except OSError:
        raise HealthcheckError("Cannot save the health probe startup snapshot.") from None
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def read_snapshot(state_path):
    try:
        with Path(state_path).open("rb") as source:
            encoded = source.read(MAX_RESPONSE_BYTES + 1)
        if len(encoded) > MAX_RESPONSE_BYTES:
            raise ValueError()
        snapshot = json.loads(encoded)
        if not isinstance(snapshot, dict) or snapshot.get("schema_version") != 1:
            raise ValueError()
        url = snapshot.get("url")
        if not isinstance(url, str):
            raise ValueError()
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme != "http" or parsed.path != "/healthz" or parsed.query or parsed.fragment:
            raise ValueError()
        if health_url(parsed.netloc) != url:
            raise ValueError()
        return url
    except (OSError, ValueError, UnicodeError, RecursionError, HealthcheckError):
        raise HealthcheckError("Missing or invalid health probe startup snapshot.") from None


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, new_url):
        return None


def check_health(state_path):
    url = read_snapshot(state_path)
    # Container/host proxy variables must never send a local probe elsewhere.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirects())
    try:
        request = urllib.request.Request(url, headers={"Accept": "application/json"})
        with opener.open(request, timeout=REQUEST_TIMEOUT) as response:
            encoded = response.read(MAX_RESPONSE_BYTES + 1)
            if response.status != 200 or len(encoded) > MAX_RESPONSE_BYTES:
                raise ValueError()
            body = json.loads(encoded)
            if not isinstance(body, dict) or body.get("status") != "ok":
                raise ValueError()
    except urllib.error.HTTPError as error:
        error.close()
        raise HealthcheckError("MediaGo health check failed or timed out.") from None
    except (OSError, ValueError, UnicodeError, RecursionError, http.client.HTTPException, urllib.error.URLError):
        raise HealthcheckError("MediaGo health check failed or timed out.") from None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--snapshot", action="store_true", help="capture the startup listen address")
    parser.add_argument("--state", default=DEFAULT_STATE, help="path of the startup snapshot")
    options = parser.parse_args(argv)
    try:
        if options.snapshot:
            save_snapshot(options.state, os.environ)
        else:
            check_health(options.state)
    except HealthcheckError as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
